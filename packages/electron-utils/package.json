{
  "name": "@timmy-studio/electron-utils",
  "version": "1.0.0",
  "description": "Vite plugin for Electron development",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "electron-dev": "./dist/cli/dev.js",
    "electron-preview": "./dist/cli/preview.js",
    "electron-build": "./dist/cli/build.js",
    "electron-package": "./dist/cli/package.js"
  },
  "exports": {
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.mjs",
      "require": "./dist/vite/index.js",
      "default": "./dist/vite/index.js"
    },
    "./ipc": {
      "types": "./dist/ipc/index.d.ts"
    },
    "./ipc/main": {
      "types": "./dist/ipc/main.d.ts",
      "import": "./dist/ipc/main.mjs",
      "require": "./dist/ipc/main.js",
      "default": "./dist/ipc/main.js"
    },
    "./ipc/preload": {
      "types": "./dist/ipc/preload.d.ts",
      "import": "./dist/ipc/preload.mjs",
      "require": "./dist/ipc/preload.js",
      "default": "./dist/ipc/preload.js"
    },
    "./ipc/renderer": {
      "types": "./dist/ipc/renderer.d.ts"
    },
    "./utils/shared": {
      "types": "./dist/utils/shared.d.ts",
      "import": "./dist/utils/shared.mjs",
      "require": "./dist/utils/shared.js",
      "default": "./dist/utils/shared.js"
    },
    "./utils/main": {
      "types": "./dist/utils/main.d.ts",
      "import": "./dist/utils/main.mjs",
      "require": "./dist/utils/main.js",
      "default": "./dist/utils/main.js"
    },
    "./utils/renderer": {
      "types": "./dist/utils/renderer.d.ts",
      "import": "./dist/utils/renderer.mjs",
      "require": "./dist/utils/renderer.js",
      "default": "./dist/utils/renderer.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "test": "vitest"
  },
  "peerDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.0.0",
    "mime-types": "^3.0.1"
  },
  "devDependencies": {
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.6.0",
    "electron": "^38.3.0",
    "tsup": "^8.3.5",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^4.0.3"
  }
}
